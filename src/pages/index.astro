---
import Layout from "@/layouts/Layout.astro";
import { Map } from "@/components/Map";
import { SidebarProvider as SidebarProviderL } from "@/components/ui/sidebar-l";
import { QuestionSidebar } from "@/components/QuestionSidebar";
import { HidingZones } from "@/components/HidingZones";
import { ZoneSheet } from "@/components/ZoneSheet";
import { LocateButton, ZoneCounter } from "@/components/MapControls";
import { MapLayersButton } from "@/components/MapLayers";
import { BottomBar } from "@/components/BottomBar";
import { OptionDrawers } from "@/components/OptionDrawers";
import { LoadingIndicator } from "@/components/LoadingIndicator";
import { TutorialDialog } from "@/components/TutorialDialog";
import { HiderScreen } from "@/components/HiderScreen";
---

<Layout className="bg-jetlag">
    <SidebarProviderL client:load>
        <QuestionSidebar client:only />
        <main class="flex h-[100svh] min-w-0 flex-grow flex-col">
            <div
                class="flex h-full flex-col"
                id="map-modal-dialog-container-leaflet"
            >
                <div class="relative min-h-0 flex-1">
                    <div class="absolute left-3 top-3 z-[1030]">
                        <ZoneCounter client:only />
                    </div>
                    <div
                        class="absolute right-3 top-3 z-[1030] flex flex-col gap-2"
                    >
                        <OptionDrawers client:load />
                        <LocateButton client:only />
                        <MapLayersButton client:only />
                    </div>
                    <div
                        class="pointer-events-none absolute left-0 right-0 top-[116px] z-[1030] mx-auto w-fit"
                    >
                        <LoadingIndicator client:only />
                    </div>
                    <Map className="h-full w-full" client:only />
                </div>
                <BottomBar client:only />
            </div>
        </main>
        <HidingZones client:only />
        <ZoneSheet client:only />
        <TutorialDialog client:only />
        <HiderScreen client:only />
    </SidebarProviderL>
</Layout>
