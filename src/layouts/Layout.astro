---
import "@/styles/globals.css";
import { ToastContainer } from "react-toastify";
// @ts-ignore
import { pwaInfo } from "virtual:pwa-info";

export interface Props {
    className?: string;
}

const { className } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/x-icon"
            href="https://danumi.github.io/JetLagHideAndSeek/favicon.ico"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="https://danumi.github.io/JetLagHideAndSeek/icon.svg"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="https://danumi.github.io/JetLagHideAndSeek/icon-180.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="https://danumi.github.io/JetLagHideAndSeek/icon-32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="https://danumi.github.io/JetLagHideAndSeek/icon-16.png"
        />
        <!-- The name under the icon on an iPhone's home screen -->
        <meta name="apple-mobile-web-app-title" content="Hide & Seek" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Oxygen:wght@300;400;700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <!-- HTML Meta Tags -->
        <title>Hide & Seek Vienna</title>
        <meta
            name="description"
            content="Map, questions and rules for our games of Jet Lag Hide and Seek in Vienna."
        />

        <!-- Link previews -->
        <meta
            property="og:url"
            content="https://danumi.github.io/JetLagHideAndSeek/"
        />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="Hide & Seek Vienna" />
        <meta
            property="og:description"
            content="Map, questions and rules for our games of Jet Lag Hide and Seek in Vienna."
        />
        <meta
            property="og:image"
            content="https://danumi.github.io/JetLagHideAndSeek/icon-1080.png"
        />
        <meta name="twitter:card" content="summary" />

        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    </head>
    <body class:list={[className, "dark"]}>
        <slot />
        <ToastContainer client:only draggable draggableDirection="x" />
    </body>
</html>
